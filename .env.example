# ---- PortalPilot configuration ----

# Default read-only endpoint. Verigate-gated writes are pinned separately to PortalDot V3 Substrate testnet.
PORTALDOT_WS=wss://mainnet.portaldot.io
PORT=8787

# Server-side Substrate transaction signer. Do not use //Alice outside a local dev node.
# For PortalDot V3 testnet writes, configure a funded testnet account.
PORTALDOT_SIGNER_SEED=

# ---- Verigate-gated native POT transfers (local single-process mode only) ----
# Operator-provided trusted adapter that creates a Verigate intent and returns
# { decision_receipt, execution_authorization }. This is not assumed to be a built-in endpoint.
VERIGATE_AUTHORIZATION_URL=
# Verigate verifier base URL; /v1/verify is called for both signed artifacts.
VERIGATE_BASE_URL=
VERIGATE_API_KEY=
# PEM file containing the pinned Ed25519 issuer public key, plus SPKI DER SHA-256 fingerprint.
VERIGATE_PUBLIC_KEY_FILE=
VERIGATE_PUBLIC_KEY_SHA256=
# Maximum fee in native POT base units (14 decimals); this exact ceiling must be signed.
VERIGATE_MAX_FEE_BASE_UNITS=

# OPTIONAL: enable free-form natural language understanding via Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
