{
  "name": "portalpilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PortalPilot — the AI copilot & command center for Portaldot",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "npm --prefix app run dev",
    "server": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npm install && npm --prefix app install && npm --prefix app run build",
    "build:web": "npm --prefix app run build",
    "build:api": "node scripts/build-api.mjs",
    "smoke": "tsx src/smoke.ts",
    "spike": "node spike.mjs",
    "test:verigate": "tsx --test tests/verigate-canonical.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@polkadot/api": "^16.5.6",
    "@polkadot/api-contract": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
